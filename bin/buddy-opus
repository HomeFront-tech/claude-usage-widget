#!/usr/bin/env python3
"""Let Grok Bot borrow Claude Opus through the buddy on this Mac.

  buddy-opus ask [--async] [--json] "<request>"   run Opus and print its answer
  buddy-opus result <id>                          an --async run's status and answer
  buddy-opus status                               is the buddy up, and how many runs are left

Grok runs this through Grok Bot Shell. The buddy has to be running with a `grok` table in
config.lua. Opus may read files and search the web on its own; anything that changes
files, runs commands or sends something goes through bin/buddy-opus-approve, which asks
the owner with an Approve / Deny panel. Runs per day are capped (grok.opus_daily_cap).

The run is kept away from the owner's own Claude Code setup: no user or project settings
(so no hooks or plugins), only the buddy's MCP server, no saved session, and a working
folder with no CLAUDE.md. Exit codes: 0 answered, 2 refused (buddy offline or feature
off), 3 capped, 4 failed.
"""
import fcntl
import json
import os
import subprocess
import sys
import time
from typing import List, Tuple

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import buddy_grok as bg  # noqa: E402

CLAUDE = os.environ.get("BUDDY_CLAUDE") or os.path.expanduser("~/.local/bin/claude")
APPROVE = os.path.join(HERE, "buddy-opus-approve")
MODEL = "claude-opus-5-5"
# Reading and searching need no click. WebFetch isn't here: a URL can carry data out, so
# it asks like everything else.
READ_TOOLS = "Read,Grep,Glob,WebSearch"
# Asked every time, even the commands Claude Code would otherwise treat as read-only (a
# `cat` could read around the deny rules below).
ASK = {"permissions": {"ask": ["Bash", "WebFetch"]}}
# Never read: login and key stores, other agents' settings, mail, messages, browsers.
DENY_DIRS = ["~/.ssh", "~/.aws", "~/.gnupg", "~/.config", "~/.kube", "~/.docker", "~/.claude", "~/.codex",
             "~/.cursor", "~/.grokbot", "~/.hermes", "~/Library/Keychains", "~/Library/Cookies",
             "~/Library/Messages", "~/Library/Mail", "~/Library/Safari", "~/Library/Containers",
             "~/Library/Application Support/Google/Chrome", "~/Library/Application Support/Firefox",
             "~/Library/Application Support/Grok Bot", "~/Library/Application Support/claude-usage-widget"]
DENY_FILES = ["~/.netrc", "~/.npmrc", "~/.pypirc", "~/.git-credentials", "~/.zsh_history", "~/.bash_history"]
# "//" makes a rule absolute; a bare "**/x" would only cover the working folder
DENY_PATTERNS = ["//**/.env*", "//**/*.pem", "//**/*.key", "//**/*.p12", "//**/id_rsa*", "//**/id_ed25519*",
                 "//**/*credential*", "//**/*secret*", "//**/*token*", "//**/*password*", "//**/*.keychain*"]
RUN_PROMPT = ("Grok Bot, {o}'s cloud AI teammate, asked for this through Buddy on {o}'s Mac. Read and think "
              "freely. Anything that changes files, runs commands or sends something needs {o}'s approval and "
              "may be denied; if it is, finish the best answer you can without it. Never include passwords, keys "
              "or tokens in your answer. Your final message goes back to Grok Bot.")
EXIT = {"answered": 0, "refused": 2, "capped": 3, "failed": 4}
REFUSED = "Buddy isn't running on this Mac, or its Grok teammate feature is off, so Opus can't run. Ask the owner."


def rule_path(p: str) -> str:
    """A folder for a permission rule: "~/x" stays, "/x" becomes "//x" (absolute), "x" is "~/x"."""
    p = p.rstrip("/")
    if p.startswith("~"):
        return p
    return "/" + p if p.startswith("/") else "~/" + p


def daily_cap(cfg: dict) -> int:
    cap = cfg.get("cap")
    return 10 if cap is None else max(0, int(cap))


def build_argv(request: str, cfg: dict) -> List[str]:
    deny = ["Read(%s/**)" % rule_path(p) for p in DENY_DIRS + list(cfg.get("deny_read") or [])]
    deny += ["Read(%s)" % p for p in DENY_FILES + DENY_PATTERNS]
    mcp = {"mcpServers": {"buddy": {"command": "/usr/bin/python3", "args": [APPROVE]}}}
    return [CLAUDE, "-p", "--model", MODEL,
            "--setting-sources", "", "--strict-mcp-config",
            "--settings", json.dumps(ASK), "--permission-mode", "manual",
            "--mcp-config", json.dumps(mcp),
            "--permission-prompt-tool", "mcp__buddy__approve",
            "--allowedTools", READ_TOOLS,
            "--disallowedTools", ",".join(deny),
            "--append-system-prompt", RUN_PROMPT.format(o=cfg.get("owner") or "the owner"),
            "--no-session-persistence", "--output-format", "json",
            "--", request]


def run_opus(run_id: str, request: str, cfg: dict) -> Tuple[str, str]:
    """Runs Opus and returns (outcome, answer or error)."""
    work = bg.STATE / "work"
    work.mkdir(parents=True, exist_ok=True)
    env = dict(os.environ, BUDDY_RUN_ID=run_id, BUDDY_STATE_DIR=str(bg.STATE), BUDDY_HS=bg.HS,
               MCP_TOOL_TIMEOUT=str((int(cfg.get("approve_timeout") or 600) + 60) * 1000))
    try:
        p = subprocess.run(build_argv(request, cfg), cwd=str(work), env=env, capture_output=True,
                           text=True, timeout=3600)
    except (OSError, subprocess.SubprocessError) as e:
        return "failed", "Couldn't run Claude Code: %s" % e
    try:
        out = json.loads(p.stdout)
    except ValueError:
        out = {}
    if p.returncode != 0 or out.get("is_error") or "result" not in out:
        why = (out.get("result") or p.stderr or p.stdout or "no output").strip()
        return "failed", "The Opus run failed: %s" % why[:500]
    return "answered", str(out["result"])


def finish(run_id: str, request: str, cfg: dict) -> Tuple[str, str]:
    started = time.time()
    bg.notify("start", " ".join(request.split())[:80])
    outcome, answer = run_opus(run_id, request, cfg)
    bg.notify("done" if outcome == "answered" else "failed", "" if outcome == "answered" else answer[:200])
    bg.log_run(run_id, outcome=outcome, seconds=round(time.time() - started), request=request[:120])
    return outcome, answer


def job_file(run_id: str):
    return bg.STATE / "jobs" / (run_id + ".json")


def write_job(run_id: str, **fields) -> None:
    path = job_file(run_id)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(dict(fields, id=run_id)))
    tmp.replace(path)


def emit(as_json: bool, outcome: str, answer: str, run_id: str = "") -> int:
    if as_json:
        print(json.dumps({"id": run_id, "outcome": outcome, "answer": answer}))
    else:
        print(answer)
    return EXIT[outcome]


def cmd_ask(args: List[str]) -> int:
    as_async, as_json = "--async" in args, "--json" in args
    words = [a for a in args if a not in ("--async", "--json")]
    if len(words) != 1:
        print('Usage: buddy-opus ask [--async] [--json] "<request>"')
        return 2
    request = words[0]
    cfg = bg.buddy_config()
    if cfg is None:
        return emit(as_json, "refused", REFUSED)
    cap = daily_cap(cfg)
    run_id = bg.claim_run(cap)
    if run_id is None:
        bg.notify("capped", "")
        return emit(as_json, "capped", "Today's Opus cap (%d runs) is used up. Try tomorrow, or ask the owner." % cap)
    if as_async:
        write_job(run_id, status="queued", request=request)
        subprocess.Popen([sys.executable, os.path.realpath(__file__), "_run", run_id],
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True)
        print(json.dumps({"id": run_id}))
        return 0
    outcome, answer = finish(run_id, request, cfg)
    return emit(as_json, outcome, answer, run_id)


def take_job(run_id: str):
    """The queued job, now marked running; None if it's missing or already started.
    One claim from the cap runs Opus once, however many workers are started for it."""
    path = job_file(run_id)
    if not path.exists():
        return None
    with path.with_suffix(".lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        job = json.loads(path.read_text())
        if job.get("status") != "queued":
            return None
        write_job(run_id, status="running", request=job["request"])
        return job


def cmd_run(run_id: str) -> int:
    job = take_job(run_id)
    if job is None:
        print("Job %s isn't waiting to run (already started, finished or unknown)." % run_id)
        return 4
    cfg = bg.buddy_config()
    if cfg is None:
        outcome, answer = "refused", REFUSED
        bg.log_run(run_id, outcome=outcome)
    else:
        outcome, answer = finish(run_id, job["request"], cfg)
    write_job(run_id, status="done", outcome=outcome, answer=answer)
    return 0


def cmd_result(run_id: str) -> int:
    path = job_file(run_id)
    if not path.exists():
        print(json.dumps({"id": run_id, "status": "unknown"}))
        return 4
    job = json.loads(path.read_text())
    job.pop("request", None)
    print(json.dumps(job))
    return 0


def cmd_status() -> int:
    running = bg.hs_call("return 'up'") is not None
    cfg = bg.buddy_config() if running else None
    cap = daily_cap(cfg) if cfg else 0
    used = bg.runs_today()
    print(json.dumps({"buddy": "running" if running else "offline", "enabled": cfg is not None,
                      "cap": cap, "used_today": used, "left": max(0, cap - used)}))
    return 0


def main(argv: List[str]) -> int:
    if argv[:1] == ["ask"]:
        return cmd_ask(argv[1:])
    if argv[:1] == ["result"] and len(argv) == 2:
        return cmd_result(argv[1])
    if argv[:1] == ["_run"] and len(argv) == 2:
        return cmd_run(argv[1])
    if argv[:1] == ["status"]:
        return cmd_status()
    print(__doc__.strip().split("\n\n")[0] + "\n\n" + __doc__.strip().split("\n\n")[1])
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
