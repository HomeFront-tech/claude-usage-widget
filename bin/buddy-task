#!/usr/bin/env python3
"""Open, message and stop the Claude Code sessions Buddy starts for a task.

  buddy-task start          stdin: {"task", "name", "folder", "origin", "terminal", "owner", "model", "effort"}
  buddy-task send <id>      stdin: the message, typed into the session as if you'd typed it
  buddy-task stop <id>      end the session
  buddy-task open <id>      a new Terminal window on a session whose window was closed
  buddy-task list           the tasks worth showing (also marks dead ones ended)
  buddy-task permit <id>    wait for one permission answer; stdin: the hook payload
  buddy-task answer <id> <rid> allow|deny
  buddy-task hook <id>      called by the session's own hooks, with the hook's JSON on stdin

Every command but hook and permit prints one JSON line: {"ok": true, ...} or {"ok": false, "error": "..."}.
The hook prints nothing: Claude Code adds a UserPromptSubmit hook's output to the prompt.
"""
import json
import os
import signal
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import buddy_tasks as bt  # noqa: E402


def reply(**fields) -> int:
    print(json.dumps(fields, ensure_ascii=False))
    return 0


def main(argv) -> int:
    cmd = argv[1] if len(argv) > 1 else ""
    task_id = argv[2] if len(argv) > 2 else ""
    if cmd in ("hook", "permit"):
        def timeout(*_):
            raise TimeoutError()
        if cmd == "permit":
            # Bound even a stuck stdin or filesystem lock below Claude Code's 600 s limit.
            signal.signal(signal.SIGALRM, timeout)
            signal.alarm(580)
        try:
            payload = json.loads(sys.stdin.read() or "{}")
            if isinstance(payload, dict):
                if cmd == "hook":
                    bt.hook(task_id, payload)
                else:
                    result = bt.permit(task_id, payload)
                    if result:
                        print(json.dumps(result))
        except Exception:  # a hook must never get in the session's way
            pass
        finally:
            if cmd == "permit":
                signal.alarm(0)
        return 0
    try:
        if cmd == "start":
            req = json.loads(sys.stdin.read() or "{}")
            if not isinstance(req, dict):
                raise bt.TaskError("Expected a JSON object.")
            return reply(ok=True, task=bt.describe(bt.start(req)))
        if cmd == "answer":
            accepted = bt.answer(task_id, argv[3] if len(argv) > 3 else "", argv[4] if len(argv) > 4 else "")
            return reply(ok=True, answered=accepted)
        if cmd == "send":
            return reply(ok=True, task=bt.describe(bt.send(task_id, sys.stdin.read())))
        if cmd == "stop":
            return reply(ok=True, task=bt.describe(bt.stop(task_id)))
        if cmd == "open":
            terminal = argv[3] if len(argv) > 3 else None
            return reply(ok=True, task=bt.describe(bt.reopen(task_id, terminal)))
        if cmd == "list":
            return reply(ok=True, tasks=[bt.describe(t) for t in bt.sweep()])
    except bt.TaskError as exc:
        return reply(ok=False, error=str(exc))
    except (OSError, ValueError) as exc:
        return reply(ok=False, error=str(exc)[:300])
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
