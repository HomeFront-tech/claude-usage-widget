#!/usr/bin/env python3
"""Run one isolated Claude request for Buddy and return one JSON response."""
import fcntl
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import List

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import buddy_claude as bc  # noqa: E402
import buddy_agent as agent  # noqa: E402

TIMEOUTS = {"quip": 45, "note": 45, "learn": 60, "ping": 30, "chat": 180, "job": 150}
RESEARCH_WORDS = ("research", "look into", "find out", "compare", "investigate",
                  "deep dive", "pros and cons", "workout plan", "diet plan", "meal plan", "plan for")
TOOLS = str((Path(HERE) / "buddy-tools").resolve())
HEALTH_DIR = "~/Library/Application Support/claude-usage-widget/health"  # health.lua's folder


def research_signal(prompt: str) -> bool:
    latest = ""
    for line in prompt.splitlines():
        if line.startswith("Them:"):
            latest = line[5:].lower()
    return any(word in latest for word in RESEARCH_WORDS)


def route(kind: str, req: dict, cfg: dict, unavailable: set) -> dict:
    selected = cfg.get("model") or "haiku"
    if kind == "ping" and isinstance(req.get("model"), str) and req["model"]:
        selected = req["model"]
    if selected == "auto":
        if kind in ("chat", "job"):
            model = next((name for name in ("opus", "sonnet", "haiku")
                          if name not in unavailable), "haiku")
        else:
            model = "haiku"
    else:
        model = selected
    helpers = kind == "chat" and research_signal(req.get("prompt", ""))
    helper_model = (next((name for name in ("sonnet", "haiku")
                          if name not in unavailable), "haiku")
                    if selected == "auto" else model) if helpers else None
    if helpers:
        timeout = 600
    elif kind in ("chat", "job"):
        timeout = (180 if kind == "chat" else 150) if model in ("haiku", "sonnet") else 300
    else:
        timeout = TIMEOUTS[kind]
    return {"model": model, "effort": "low" if kind in ("quip", "note", "learn", "ping") else None,
            "helpers": helpers, "helper_model": helper_model, "timeout": timeout}


def build_argv(kind: str, req: dict, cfg: dict, choice: dict) -> List[str]:
    argv = bc.base_argv(choice["model"]) + [
        "--system-prompt", req["system"], "--input-format", "stream-json",
        "--output-format", "stream-json", "--verbose"]
    if kind in ("quip", "note", "learn", "ping"):
        return argv + ["--tools", "", "--max-turns", "1", "--effort", "low"]

    web = kind == "chat" and cfg.get("web_search", True)
    server_env = {"BUDDY_TOOLS_MODE": kind, "BUDDY_AGENT_DIR": str(agent.AGENT),
                  "BUDDY_CHAT_ARCHIVE": os.path.expanduser(
                      "~/Library/Application Support/claude-usage-widget/chat-archive.jsonl")}
    if kind == "job":
        server_env["BUDDY_ALLOWED_SOURCES"] = ",".join(req.get("sources") or [])
    elif cfg.get("health") is True:  # config.lua turned the health sidekick on
        server_env["BUDDY_HEALTH_DIR"] = os.path.expanduser(HEALTH_DIR)
    mcp = {"mcpServers": {"buddy": {"command": "/usr/bin/python3",
                                    "args": [TOOLS], "env": server_env}}}
    tools = ["WebSearch"] if web else []
    allowed = ["mcp__buddy"] + (["WebSearch"] if web else [])
    if choice["helpers"]:
        helper = {"helper": {
            "description": "Digs into research questions and reports back what it found.",
            "prompt": req["system"] + "\nReport findings plainly; never send, change or delete anything.",
            "model": choice["helper_model"],
            "tools": ["mcp__buddy__find_files", "mcp__buddy__list_folder",
                      "mcp__buddy__read_file", "mcp__buddy__read_source"] +
                     (["WebSearch"] if web else [])}}
        argv += ["--agents", json.dumps(helper)]
        tools.append("Agent")
        allowed.append("Agent")
    return argv + ["--tools", ",".join(tools),
                   "--mcp-config", json.dumps(mcp),
                   "--allowedTools", ",".join(allowed),
                   "--max-turns", "12"]


def user_message(req: dict) -> str:
    content = []
    if req.get("image"):
        content.append({"type": "image", "source": {"type": "base64",
                        "media_type": "image/jpeg", "data": req["image"]}})
    content.append({"type": "text", "text": req["prompt"]})
    return json.dumps({"type": "user", "message": {"role": "user", "content": content}}) + "\n"


def parse_output(stdout: str):
    result, tools = None, []
    for line in stdout.splitlines():
        try:
            item = json.loads(line)
        except ValueError:
            continue
        if not isinstance(item, dict):
            continue
        if item.get("type") == "assistant":
            message = item.get("message") or {}
            if not isinstance(message, dict):
                continue
            for block in message.get("content") or []:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    name = block.get("name")
                    if isinstance(name, str):
                        tools.append(name)
        elif item.get("type") == "result":
            result = item
    return result, tools


def models_from(result: dict) -> dict[str, list[int]]:
    usage = result.get("usage") or {}
    cache_creation = usage.get("cache_creation") or {}
    total_write = usage.get("cache_creation_input_tokens") or 0
    one_hour = cache_creation.get("ephemeral_1h_input_tokens") or 0
    ratio = one_hour / total_write if total_write else 0
    models = {}
    for name, counts in (result.get("modelUsage") or {}).items():
        write = counts.get("cacheCreationInputTokens") or 0
        models[name] = [counts.get("inputTokens") or 0,
                        counts.get("outputTokens") or 0,
                        write, counts.get("cacheReadInputTokens") or 0,
                        round(write * ratio)]
    return models


def response(ok=False, text=None, error=None, tools=None, ms=0, model=None):
    return {"ok": ok, "text": text, "error": error, "tools": tools or [], "ms": ms, "model": model}


def model_unavailable(error: str) -> bool:
    lowered = error.lower()
    return "model" in lowered and any(word in lowered for word in
                                      ("not available", "not found", "access", "invalid"))


def model_cache() -> dict:
    try:
        value = json.loads((agent.AGENT / "models.json").read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def mark_model(_cache: dict, model: str, ok: bool) -> None:
    agent.AGENT.mkdir(parents=True, exist_ok=True)
    with (agent.AGENT / "models.lock").open("a+") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            cache = model_cache()
            cache[model] = {"ok": ok, "at": time.time()}
            temp = agent.AGENT / ("models.%d.tmp" % os.getpid())
            try:
                temp.write_text(json.dumps(cache) + "\n")
                os.replace(str(temp), str(agent.AGENT / "models.json"))
            finally:
                if temp.exists():
                    temp.unlink()
        finally:
            fcntl.flock(lock, fcntl.LOCK_UN)


def run(req: dict) -> dict:
    started = time.monotonic()
    kind = req["kind"]
    result, called = None, []
    output = response()
    cfg = agent.load_config()
    cache = model_cache()
    now = time.time()
    unavailable = {name for name, state in cache.items()
                   if isinstance(state, dict) and state.get("ok") is False and
                   isinstance(state.get("at"), (int, float)) and now - state["at"] < 86400}
    choice = route(kind, req, cfg, unavailable)
    output["model"] = choice["model"]
    try:
        for attempt in range(2):
            timeout = float(os.environ.get("BUDDY_AGENT_TIMEOUT", choice["timeout"]))
            process = subprocess.Popen(build_argv(kind, req, cfg, choice),
                                       cwd=str(bc.work_dir(agent.AGENT)),
                                       env=dict(os.environ, PATH=bc.CHILD_PATH),
                                       stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                       stderr=subprocess.PIPE, text=True,
                                       start_new_session=True)
            try:
                stdout, stderr = process.communicate(user_message(req), timeout=timeout)
            except subprocess.TimeoutExpired:
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.communicate()
                output["error"] = "timeout"
                break
            else:
                result, called = parse_output(stdout)
                output["tools"] = called
                if result is not None:
                    value = result.get("result")
                    output["ok"] = not result.get("is_error", False)
                    output["text"] = value
                    if not output["ok"]:
                        output["error"] = str(value)[:300]
                else:
                    output["error"] = (stderr.strip().splitlines()[-1] if stderr.strip()
                                       else "Claude returned no result")[:200]
                if output["ok"]:
                    mark_model(cache, choice["model"], True)
                    break
                if model_unavailable(output["error"] or ""):
                    mark_model(cache, choice["model"], False)
                    if cfg.get("model") == "auto" and attempt == 0:
                        unavailable.add(choice["model"])
                        next_choice = route(kind, req, cfg, unavailable)
                        if next_choice["model"] != choice["model"]:
                            choice = next_choice
                            output = response(model=choice["model"])
                            continue
                    elif cfg.get("model") != "auto":
                        name = choice["model"].capitalize()
                        output["error"] = f"{name} isn't on your plan. Right-click me → Brain to pick another."
                break
    except (OSError, ValueError) as exc:
        output["error"] = str(exc)[:200]
    output["ms"] = int((time.monotonic() - started) * 1000)
    usage = (result.get("usage") or {}) if result else {}
    agent.log({"engine": "claude", "model": output["model"],
               "models": models_from(result or {}),
               "kind": kind, "job_id": req.get("job_id"), "ok": output["ok"],
               "ms": output["ms"], "tools": called,
               "input_tokens": usage.get("input_tokens"),
               "output_tokens": usage.get("output_tokens"),
               "cache_read_input_tokens": usage.get("cache_read_input_tokens"),
               "cache_creation_input_tokens": usage.get("cache_creation_input_tokens")})
    return output


def main() -> int:
    try:
        req = json.loads(sys.stdin.read())
    except ValueError:
        req = None
    if not isinstance(req, dict) or req.get("kind") not in TIMEOUTS:
        print(json.dumps(response(error="Invalid request kind or JSON")))
        return 0
    if not isinstance(req.get("system"), str) or not isinstance(req.get("prompt"), str):
        print(json.dumps(response(error="system and prompt must be strings")))
        return 0
    if "image" in req and not isinstance(req["image"], str):
        print(json.dumps(response(error="image must be a string")))
        return 0
    if "sources" in req and (not isinstance(req["sources"], list) or
                             not all(isinstance(name, str) for name in req["sources"])):
        print(json.dumps(response(error="sources must be a list of strings")))
        return 0
    print(json.dumps(run(req), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
