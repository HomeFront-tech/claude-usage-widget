#!/usr/bin/env python3
"""Run one isolated Claude request for Buddy and return one JSON response."""
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path
from typing import List

HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
import buddy_claude as bc  # noqa: E402
import buddy_agent as agent  # noqa: E402

TIMEOUTS = {"quip": 45, "note": 45, "chat": 180, "job": 150}
TOOLS = str((Path(HERE) / "buddy-tools").resolve())


def build_argv(kind: str, req: dict, cfg: dict) -> List[str]:
    argv = bc.base_argv(cfg.get("model") or "haiku") + [
        "--system-prompt", req["system"], "--input-format", "stream-json",
        "--output-format", "stream-json", "--verbose"]
    if kind in ("quip", "note"):
        return argv + ["--tools", "", "--max-turns", "1", "--effort", "low"]

    web = kind == "chat" and cfg.get("web_search", True)
    server_env = {"BUDDY_TOOLS_MODE": kind, "BUDDY_AGENT_DIR": str(agent.AGENT)}
    if kind == "job":
        server_env["BUDDY_ALLOWED_SOURCES"] = ",".join(req.get("sources") or [])
    mcp = {"mcpServers": {"buddy": {"command": "/usr/bin/python3",
                                    "args": [TOOLS], "env": server_env}}}
    return argv + ["--tools", "WebSearch" if web else "",
                   "--mcp-config", json.dumps(mcp),
                   "--allowedTools", "mcp__buddy" + (",WebSearch" if web else ""),
                   "--max-turns", "12"]


def user_message(req: dict) -> str:
    content = []
    if req.get("image"):
        content.append({"type": "image", "source": {"type": "base64",
                        "media_type": "image/jpeg", "data": req["image"]}})
    content.append({"type": "text", "text": req["prompt"]})
    return json.dumps({"type": "user", "message": {"role": "user", "content": content}}) + "\n"


def parse_output(stdout: str):
    result, tools = None, []
    for line in stdout.splitlines():
        try:
            item = json.loads(line)
        except ValueError:
            continue
        if not isinstance(item, dict):
            continue
        if item.get("type") == "assistant":
            message = item.get("message") or {}
            if not isinstance(message, dict):
                continue
            for block in message.get("content") or []:
                if isinstance(block, dict) and block.get("type") == "tool_use":
                    name = block.get("name")
                    if isinstance(name, str):
                        tools.append(name)
        elif item.get("type") == "result":
            result = item
    return result, tools


def response(ok=False, text=None, error=None, tools=None, ms=0):
    return {"ok": ok, "text": text, "error": error, "tools": tools or [], "ms": ms}


def run(req: dict) -> dict:
    started = time.monotonic()
    kind = req["kind"]
    result, called = None, []
    output = response()
    try:
        process = subprocess.Popen(build_argv(kind, req, agent.load_config()),
                                   cwd=str(bc.work_dir(agent.AGENT)),
                                   env=dict(os.environ, PATH=bc.CHILD_PATH),
                                   stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                   stderr=subprocess.PIPE, text=True,
                                   start_new_session=True)
        try:
            stdout, stderr = process.communicate(user_message(req), timeout=TIMEOUTS[kind])
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            process.communicate()
            output["error"] = "timeout"
        else:
            result, called = parse_output(stdout)
            output["tools"] = called
            if result is not None:
                value = result.get("result")
                output["ok"] = not result.get("is_error", False) and process.returncode == 0
                output["text"] = value if output["ok"] else None
                if not output["ok"]:
                    detail = value or (stderr.strip().splitlines()[-1] if stderr.strip()
                                       else "Claude failed")
                    output["error"] = str(detail)[:200]
            else:
                output["error"] = (stderr.strip().splitlines()[-1] if stderr.strip()
                                   else "Claude returned no result")[:200]
    except (OSError, ValueError) as exc:
        output["error"] = str(exc)[:200]
    output["ms"] = int((time.monotonic() - started) * 1000)
    usage = (result.get("usage") or {}) if result else {}
    agent.log({"kind": kind, "job_id": req.get("job_id"), "ok": output["ok"],
               "ms": output["ms"], "tools": called,
               "input_tokens": usage.get("input_tokens"),
               "output_tokens": usage.get("output_tokens")})
    return output


def main() -> int:
    try:
        req = json.loads(sys.stdin.read())
    except ValueError:
        req = None
    if not isinstance(req, dict) or req.get("kind") not in TIMEOUTS:
        print(json.dumps(response(error="Invalid request kind or JSON")))
        return 0
    if not isinstance(req.get("system"), str) or not isinstance(req.get("prompt"), str):
        print(json.dumps(response(error="system and prompt must be strings")))
        return 0
    if "image" in req and not isinstance(req["image"], str):
        print(json.dumps(response(error="image must be a string")))
        return 0
    if "sources" in req and (not isinstance(req["sources"], list) or
                             not all(isinstance(name, str) for name in req["sources"])):
        print(json.dumps(response(error="sources must be a list of strings")))
        return 0
    print(json.dumps(run(req), ensure_ascii=False))
    return 0


if __name__ == "__main__":
    sys.exit(main())
