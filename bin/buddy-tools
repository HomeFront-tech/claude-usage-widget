#!/usr/bin/env python3
"""Buddy's small stdio MCP server for local reading and agent notes."""
import json
import io
import os
import codecs
import re
import secrets
import selectors
import signal
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import buddy_agent as agent  # noqa: E402
from buddy_claude import CHILD_PATH  # noqa: E402

MODE = os.environ.get("BUDDY_TOOLS_MODE", "chat")
JOB_TOOLS = {"find_files", "list_folder", "read_file", "read_source", "automations_list", "remember"}


def spec(name, description, props=None, required=None):
    return {"name": name, "description": description,
            "inputSchema": {"type": "object", "properties": props or {}, "required": required or []}}


STRING = {"type": "string"}
TRIGGER = {"type": "object", "properties": {
    "type": {"type": "string", "enum": ["sit_down", "daily_at"],
             "description": "sit_down = the first time the owner sits down at the Mac after a long break (the morning); daily_at = every day at a set time"},
    "at": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
           "description": "24-hour HH:MM, only for daily_at"}}, "required": ["type"]}
JOB_NAME = {"type": "string", "description": "Short name for this automation."}
INSTRUCTIONS = {"type": "string", "description": "What Buddy should do when it runs."}
SOURCES = {"type": "array", "items": STRING, "description": "Configured source names Buddy may read."}
TOOLS = [
    spec("find_files", "Find local files by name or text.", {"query": STRING, "limit": {"type": "integer", "default": 20}}, ["query"]),
    spec("list_folder", "List a folder's entries.", {"path": STRING}, ["path"]),
    spec("read_file", "Read a local text file.", {"path": STRING, "max_chars": {"type": "integer", "default": 20000}}, ["path"]),
    spec("reveal", "Show a file in Finder.", {"path": STRING}, ["path"]),
    spec("open", "Open a file, app or web link.", {"target": STRING}, ["target"]),
    spec("read_source", "Read a configured local source.", {"name": STRING, "arg": STRING}, ["name"]),
    spec("automations_list", "List Buddy automations."),
    spec("automations_add", "Add a Buddy automation.", {"name": JOB_NAME, "trigger": TRIGGER, "instructions": INSTRUCTIONS, "sources": SOURCES}, ["name", "trigger", "instructions", "sources"]),
    spec("automations_change", "Change a Buddy automation.", {"id": STRING, "name": JOB_NAME, "trigger": TRIGGER, "instructions": INSTRUCTIONS, "sources": SOURCES, "enabled": {"type": "boolean"}}, ["id"]),
    spec("automations_remove", "Remove a Buddy automation.", {"id": STRING}, ["id"]),
    spec("remember", "Keep a note for Buddy.", {"note": STRING}, ["note"]),
]


def result(value, error=False):
    return {"content": [{"type": "text", "text": str(value)}], "isError": error}


def fail(message):
    raise ValueError(message)


def path_of(value):
    path = os.path.realpath(os.path.expanduser(str(value)))
    if agent.denied(path, agent.load_config().get("private_paths", [])):
        fail("That path is private.")
    return path


def child(argv, timeout=15):
    if not argv or not os.path.isabs(argv[0]) or not all(isinstance(x, str) for x in argv):
        fail("The configured command must use an absolute executable path and an argv list.")
    return subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                          timeout=timeout, env=dict(os.environ, PATH=CHILD_PATH))


def source_child(argv, timeout, limit=60000):
    if not argv or not os.path.isabs(argv[0]) or not all(isinstance(x, str) for x in argv):
        fail("The configured command must use an absolute executable path and an argv list.")
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, start_new_session=True,
                            env=dict(os.environ, PATH=CHILD_PATH))
    decoder = codecs.getincrementaldecoder("utf-8")("replace")
    err_decoder = codecs.getincrementaldecoder("utf-8")("replace")
    stdout, stderr = [], ""
    length, truncated = 0, False
    deadline = time.monotonic() + timeout
    streams = selectors.DefaultSelector()
    streams.register(proc.stdout, selectors.EVENT_READ, "out")
    streams.register(proc.stderr, selectors.EVENT_READ, "err")
    try:
        while streams.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout)
            ready = streams.select(remaining)
            if not ready:
                raise subprocess.TimeoutExpired(argv, timeout)
            for key, _ in ready:
                data = os.read(key.fileobj.fileno(), 8192)
                if not data:
                    streams.unregister(key.fileobj)
                    continue
                if key.data == "err":
                    stderr = (stderr + err_decoder.decode(data))[-300:]
                else:
                    chunk = decoder.decode(data)
                    room = limit - length
                    if len(chunk) > room:
                        stdout.append(chunk[:room])
                        truncated = True
                        try:
                            os.killpg(proc.pid, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
                        break
                    stdout.append(chunk)
                    length += len(chunk)
            if truncated:
                break
        if not truncated:
            stdout.append(decoder.decode(b"", final=True))
            stderr = (stderr + err_decoder.decode(b"", final=True))[-300:]
        proc.wait(timeout=max(0.1, deadline - time.monotonic()))
        return subprocess.CompletedProcess(argv, 0 if truncated else proc.returncode,
                                           "".join(stdout), stderr), truncated
    except (subprocess.TimeoutExpired, OSError):
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        proc.wait()
        raise
    finally:
        streams.close()
        proc.stdout.close()
        proc.stderr.close()


def find_files(args):
    query = str(args.get("query", "")).strip()
    if not query:
        fail("Give me a search query.")
    limit = max(1, min(int(args.get("limit", 20)), 200))
    config = agent.load_config()
    search = config.get("search")
    commands = []
    if isinstance(search, list) and search:
        commands.append(search + [query])
    home = os.path.expanduser("~")
    commands.extend([["/usr/bin/mdfind", "-onlyin", home, "-name", query],
                     ["/usr/bin/mdfind", "-onlyin", home, query]])
    found, seen = [], set()
    for argv in commands:
        try:
            proc = child(argv)
        except (OSError, subprocess.TimeoutExpired, ValueError):
            continue
        if proc.returncode:
            continue
        for line in proc.stdout.splitlines():
            candidate = line.split("  ", 1)[0].strip()
            if not candidate.startswith(("/", "~")):
                continue
            path = os.path.realpath(os.path.expanduser(candidate))
            if not os.path.exists(path) or path in seen or agent.denied(path, config.get("private_paths", [])):
                continue
            found.append(path)
            seen.add(path)
            if len(found) >= limit:
                return "\n".join(found)
    return "\n".join(found)


def list_folder(args):
    path = path_of(args.get("path", ""))
    if not os.path.isdir(path):
        fail("That's not a folder.")
    entries = []
    for entry in sorted(os.scandir(path), key=lambda item: item.name.lower()):
        if agent.denied(entry.path, agent.load_config().get("private_paths", [])):
            continue
        entries.append(entry.name + ("/" if entry.is_dir() else ""))
        if len(entries) == 200:
            break
    return "\n".join(entries)


def read_file(args):
    path = path_of(args.get("path", ""))
    if not os.path.isfile(path):
        fail("That's not a file.")
    limit = max(1, min(int(args.get("max_chars", 20000)), 100000))
    with open(path, "rb") as stream:
        head = stream.read(4096)
        if b"\0" in head:
            fail("That's not a text file.")
        size = stream.seek(0, os.SEEK_END)
        stream.seek(0)
        value = io.TextIOWrapper(stream, encoding="utf-8", errors="replace").read(limit + 1)
    if len(value) <= limit and size <= len(value.encode("utf-8")):
        return value
    return value[:limit] + "\n[… truncated, about %d more bytes]" % max(1, size - len(value[:limit].encode("utf-8")))


def reveal(args):
    path = path_of(args.get("path", ""))
    if not os.path.exists(path):
        fail("That path doesn't exist.")
    proc = child([os.environ.get("BUDDY_OPEN", "/usr/bin/open"), "-R", path])
    if proc.returncode:
        fail("Finder couldn't show that path.")
    return "Showing %s in Finder." % os.path.basename(path)


def open_target(args):
    target = str(args.get("target", ""))
    executable = os.environ.get("BUDDY_OPEN", "/usr/bin/open")
    if re.match(r"^https?://", target, re.I):
        argv = [executable, target]
    elif os.path.exists(os.path.expanduser(target)):
        path = path_of(target)
        suffix = Path(path).suffix.lower()
        if suffix in {".command", ".tool", ".sh", ".terminal", ".workflow", ".action", ".pkg", ".mpkg", ".jar"} or (suffix != ".app" and os.path.isfile(path) and os.access(path, os.X_OK)):
            fail("I don't open scripts or installers.")
        argv = [executable, path]
    elif re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:", target):
        fail("I only open files, apps and web links.")
    else:
        if not target:
            fail("Give me an app, file or web link.")
        argv = [executable, "-a", target]
    proc = child(argv)
    if proc.returncode:
        if "-a" in argv:
            fail("Couldn't find an app called %s." % target)
        fail("I couldn't open that.")
    return "Opened %s." % target


def read_source(args):
    name = str(args.get("name", ""))
    sources = agent.load_config().get("sources") or {}
    if name not in sources:
        fail("Unknown source: %s." % name)
    if MODE == "job" and name not in os.environ.get("BUDDY_ALLOWED_SOURCES", "").split(","):
        fail("That source isn't allowed for this job.")
    source = sources[name]
    argv = source.get("cmd")
    arg = str(args.get("arg", ""))
    pattern = source.get("arg")
    if pattern and not re.fullmatch(pattern, arg):
        fail("That source argument is invalid.")
    if not isinstance(argv, list):
        fail("That source isn't configured with an argv list.")
    if any(isinstance(part, str) and "{arg}" in part for part in argv) and not pattern:
        fail("That source needs an argument rule.")
    argv = [part.replace("{arg}", arg) if isinstance(part, str) else part for part in argv]
    timeout = float(os.environ.get("BUDDY_SOURCE_TIMEOUT", "60"))
    try:
        proc, truncated = source_child(argv, timeout=timeout)
    except subprocess.TimeoutExpired:
        fail("%s didn't answer in 60 s." % name)
    if proc.returncode:
        fail("%s failed: %s" % (name, proc.stderr[-300:].strip()))
    return proc.stdout.rstrip("\n") + ("\n[… truncated]" if truncated else "")


def trigger_valid(value):
    message = 'Invalid trigger. Use {"type": "sit_down"} or {"type": "daily_at", "at": "HH:MM"}.'
    if not isinstance(value, dict):
        fail(message)
    if value.get("type") == "sit_down":
        return
    if value.get("type") == "daily_at" and re.fullmatch(r"(?:[01][0-9]|2[0-3]):[0-5][0-9]", str(value.get("at", ""))):
        return
    fail(message)


def sources_valid(value):
    if not isinstance(value, list) or any(name not in (agent.load_config().get("sources") or {}) for name in value):
        fail("Unknown source in automation.")


def automations_list(args):
    runs = agent.load_runs()
    lines = []
    for job in agent.load_jobs():
        trigger = job.get("trigger") or {}
        words = "when I sit down" if trigger.get("type") == "sit_down" else "daily at %s" % trigger.get("at", "?")
        run = runs.get(job.get("id"), {})
        when = run.get("finishedAt") or run.get("startedAt") or "never" if isinstance(run, dict) else "never"
        outcome = (" (succeeded)" if run.get("ok") else " (failed)") if isinstance(run, dict) and "ok" in run else ""
        lines.append("%s | %s | %s | sources: %s | enabled: %s | last run: %s%s" %
                     (job.get("id"), job.get("name"), words, ", ".join(job.get("sources", [])),
                      job.get("enabled"), when, outcome))
    return "\n".join(lines)


def automations_add(args):
    name = str(args.get("name", "")).strip()
    instructions = str(args.get("instructions", "")).strip()
    if not name or not instructions:
        fail("Name and instructions are required.")
    trigger = args.get("trigger")
    sources = args.get("sources")
    trigger_valid(trigger)
    sources_valid(sources)
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "job"
    job = {"id": slug + "-" + secrets.token_hex(2), "name": name, "trigger": trigger,
           "instructions": instructions, "sources": sources, "enabled": True,
           "created_at": datetime.now().isoformat(timespec="seconds")}
    with agent.edit_jobs() as jobs:
        jobs.append(job)
    return json.dumps(job, ensure_ascii=False)


def automations_change(args):
    if "trigger" in args:
        trigger_valid(args["trigger"])
    if "sources" in args:
        sources_valid(args["sources"])
    with agent.edit_jobs() as jobs:
        job = next((item for item in jobs if item.get("id") == args.get("id")), None)
        if job is None:
            fail("Unknown automation.")
        for key in ("name", "trigger", "instructions", "sources", "enabled"):
            if key in args:
                job[key] = args[key]
    return json.dumps(job, ensure_ascii=False)


def automations_remove(args):
    with agent.edit_jobs() as jobs:
        job = next((item for item in jobs if item.get("id") == args.get("id")), None)
        if job is None:
            fail("Unknown automation.")
        jobs[:] = [item for item in jobs if item is not job]
    return "Removed %s." % job.get("name", "automation")


def remember(args):
    note = str(args.get("note", "")).strip()
    if not note:
        fail("Give me a note.")
    agent.AGENT.mkdir(parents=True, exist_ok=True)
    with (agent.AGENT / "notes-new.jsonl").open("a") as out:
        out.write(json.dumps({"note": note}, ensure_ascii=False) + "\n")
    return "Noted."


CALLS = {"find_files": find_files, "list_folder": list_folder, "read_file": read_file,
         "reveal": reveal, "open": open_target, "read_source": read_source,
         "automations_list": automations_list, "automations_add": automations_add,
         "automations_change": automations_change, "automations_remove": automations_remove,
         "remember": remember}


def tool_specs():
    configured = agent.load_config().get("sources") or {}
    allowed = set(os.environ.get("BUDDY_ALLOWED_SOURCES", "").split(",")) if MODE == "job" else None
    catalog = []
    for name, source in sorted(configured.items()):
        if (allowed is None or name in allowed) and isinstance(source, dict):
            catalog.append("%s — %s (argument: %s)" %
                           (name, source.get("about", "No description"), source.get("arg", "none")))
    details = "\n".join(catalog) if catalog else "No sources configured."
    descriptions = {
        "read_source": "Read a configured local source. Source names must be names from this list:\n" + details,
        "automations_add": "Add a Buddy automation. Sources must be names from this list:\n" + details,
        "automations_change": "Change a Buddy automation. Sources must be names from this list:\n" + details,
    }
    return [dict(tool, description=descriptions.get(tool["name"], tool["description"]))
            for tool in TOOLS if MODE != "job" or tool["name"] in JOB_TOOLS]


def handle(msg):
    method, params = msg.get("method"), msg.get("params") or {}
    if method == "initialize":
        return {"protocolVersion": params.get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}}, "serverInfo": {"name": "buddy", "version": "1"}}
    if method == "tools/list":
        return {"tools": tool_specs()}
    if method == "tools/call":
        name = params.get("name")
        ok = False
        try:
            if name not in CALLS or (MODE == "job" and name not in JOB_TOOLS):
                fail("That tool isn't available.")
            value = CALLS[name](params.get("arguments") or {})
            ok = True
            return result(value)
        except subprocess.TimeoutExpired:
            return result("That tool took too long.", True)
        except (ValueError, OSError, TypeError, KeyError, re.error, subprocess.SubprocessError) as exc:
            return result(str(exc), True)
        finally:
            agent.log({"tool": name, "ok": ok, "mode": MODE})
    if method == "ping":
        return {}
    raise LookupError(method)


def main():
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if "id" not in msg:
            continue
        try:
            reply = {"jsonrpc": "2.0", "id": msg["id"], "result": handle(msg)}
        except LookupError as exc:
            reply = {"jsonrpc": "2.0", "id": msg["id"], "error": {"code": -32601, "message": "unknown method %s" % exc}}
        sys.stdout.write(json.dumps(reply) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
