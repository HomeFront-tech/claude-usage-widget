import signal
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import buddy_agent as agent  # noqa: E402
import buddy_ai as ai  # noqa: E402
import buddy_tasks as tasks  # noqa: E402
from buddy_claude import CHILD_PATH  # noqa: E402

MODE = os.environ.get("BUDDY_TOOLS_MODE", "chat")
JOB_TOOLS = {"find_files", "list_folder", "read_file", "read_source", "automations_list", "remember", "chat_search"}
HEALTH_KINDS = ("meal", "workout", "break", "goal", "plan", "note")
HEALTH_DAYS = 7
HEALTH_TOOLS = {"health_log", "health_get"}
TASK_TOOLS = {"task_start", "task_send", "task_list"}


def spec(name, description, props=None, required=None):
    return {"name": name, "description": description,
            "inputSchema": {"type": "object", "properties": props or {}, "required": required or []}}


STRING = {"type": "string"}
TRIGGER = {"type": "object", "properties": {
    "type": {"type": "string", "enum": ["sit_down", "daily_at", "every"],
             "description": "sit_down = after a long break; daily_at = each day at a set time; every = a temporary watch"},
    "at": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
           "description": "24-hour HH:MM, only for daily_at"},
    "minutes": {"type": "integer", "description": "Interval in minutes, at least ai.watch_min (15 by default)"},
    "until": {"type": "integer", "description": "Unix time when the watch ends, at most 7 days ahead; defaults to tonight"}}, "required": ["type"]}
JOB_NAME = {"type": "string", "description": "Short name for this automation."}
INSTRUCTIONS = {"type": "string", "description": "What Buddy should do when it runs."}
SOURCES = {"type": "array", "items": STRING, "description": "Configured source names Buddy may read."}
TOOLS = [
    spec("find_files", "Find local files by name or text.", {"query": STRING, "limit": {"type": "integer", "default": 20}}, ["query"]),
    spec("list_folder", "List a folder's entries.", {"path": STRING}, ["path"]),
    spec("read_file", "Read a local text file.", {"path": STRING, "max_chars": {"type": "integer", "default": 20000}}, ["path"]),
    spec("reveal", "Show a file in Finder.", {"path": STRING}, ["path"]),
    spec("open", "Open a file, app or web link.", {"target": STRING}, ["target"]),
    spec("read_source", "Read a configured local source.", {"name": STRING, "arg": STRING}, ["name"]),
    spec("automations_list", "List Buddy automations."),
    spec("automations_add", "Add a Buddy automation.", {"name": JOB_NAME, "trigger": TRIGGER, "instructions": INSTRUCTIONS, "sources": SOURCES}, ["name", "trigger", "instructions", "sources"]),
    spec("automations_change", "Change a Buddy automation.", {"id": STRING, "name": JOB_NAME, "trigger": TRIGGER, "instructions": INSTRUCTIONS, "sources": SOURCES, "enabled": {"type": "boolean"}}, ["id"]),
    spec("automations_remove", "Remove a Buddy automation.", {"id": STRING}, ["id"]),
    spec("remember", "Keep a note for Buddy.", {"note": STRING}, ["note"]),
    spec("chat_search", "Search older conversations with Buddy. Read only; results include nearby lines.",
         {"query": STRING, "limit": {"type": "integer", "default": 10}}, ["query"]),
    spec("health_log", "Record something about the owner's health: a meal they ate, a workout, a break, a goal, a workout or meal plan, or a note.",
         {"kind": {"type": "string", "enum": list(HEALTH_KINDS)}, "text": STRING}, ["kind", "text"]),
    spec("health_get", "Read the owner's health goals, plans and the last 7 days of meals, workouts and breaks."),
    spec("task_start", "Start a separate Claude Code session on this Mac, in its own Terminal window, dedicated to one "
         "bigger job they ask for, like building or fixing something. It runs with Remote Control so they can drive it "
         "from the Claude app on their phone, and Buddy passes its updates on to them. Buddy asks them for a yes first.",
         {"task": {"type": "string", "description": "Everything the new session needs to do the job: what they asked for, "
                   "in their words, plus anything from this chat it should know. It starts knowing nothing else."},
          "name": {"type": "string", "description": "A short name for the session, two to five words."},
          "folder": {"type": "string", "description": "The folder it works in."}}, ["task", "name"]),
    spec("task_send", "Pass a message on to one of the Claude Code sessions Buddy started, typed in as if they'd typed it: "
         "an answer to its question, a change of plan, more to do. Buddy asks them for a yes first unless the message is "
         "their own words.", {"id": {"type": "string", "description": "The session's id, from task_list."}, "text": STRING},
         ["id", "text"]),
    spec("task_list", "List the Claude Code sessions Buddy started for them: id, name, state, folder, phone link and "
         "the last thing each said."),
    spec("ai_list", "Which AI tools are on this Mac (Claude Code, Codex, Cursor, Grok, ChatGPT, Kimi and others), "
         "whether each is open, and how recently each was used. Read-only: file dates only, never anyone's chats or logins."),
]


def result(value, error=False):
    return {"content": [{"type": "text", "text": str(value)}], "isError": error}


def fail(message):
    raise ValueError(message)


def path_of(value):
    path = os.path.realpath(os.path.expanduser(str(value)))
    if agent.denied(path, agent.load_config().get("private_paths", [])):
        fail("That path is private.")
    return path


def child(argv, timeout=15):
    if not argv or not os.path.isabs(argv[0]) or not all(isinstance(x, str) for x in argv):
        fail("The configured command must use an absolute executable path and an argv list.")
    return subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True,
                          timeout=timeout, env=dict(os.environ, PATH=CHILD_PATH))


def source_child(argv, timeout, limit=60000):
    if not argv or not os.path.isabs(argv[0]) or not all(isinstance(x, str) for x in argv):
        fail("The configured command must use an absolute executable path and an argv list.")
    proc = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, start_new_session=True,
                            env=dict(os.environ, PATH=CHILD_PATH))
    decoder = codecs.getincrementaldecoder("utf-8")("replace")
    err_decoder = codecs.getincrementaldecoder("utf-8")("replace")
    stdout, stderr = [], ""
    length, truncated = 0, False
    deadline = time.monotonic() + timeout
    streams = selectors.DefaultSelector()
    streams.register(proc.stdout, selectors.EVENT_READ, "out")
    streams.register(proc.stderr, selectors.EVENT_READ, "err")
    try:
        while streams.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise subprocess.TimeoutExpired(argv, timeout)
            ready = streams.select(remaining)
            if not ready:
                raise subprocess.TimeoutExpired(argv, timeout)
            for key, _ in ready:
                data = os.read(key.fileobj.fileno(), 8192)
                if not data:
                    streams.unregister(key.fileobj)
                    continue
                if key.data == "err":
                    stderr = (stderr + err_decoder.decode(data))[-300:]
                else:
                    chunk = decoder.decode(data)
                    room = limit - length
                    if len(chunk) > room:
                        stdout.append(chunk[:room])
                        truncated = True
                        try:
                            os.killpg(proc.pid, signal.SIGKILL)
                        except ProcessLookupError:
                            pass
                        break
                    stdout.append(chunk)
                    length += len(chunk)
            if truncated:
                break
        if not truncated:
            stdout.append(decoder.decode(b"", final=True))
            stderr = (stderr + err_decoder.decode(b"", final=True))[-300:]
        proc.wait(timeout=max(0.1, deadline - time.monotonic()))
        return subprocess.CompletedProcess(argv, 0 if truncated else proc.returncode,
                                           "".join(stdout), stderr), truncated
    except (subprocess.TimeoutExpired, OSError):
        if proc.poll() is None:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
        proc.wait()
        raise
    finally:
        streams.close()
        proc.stdout.close()
        proc.stderr.close()


def find_files(args):
    query = str(args.get("query", "")).strip()
    if not query:
        fail("Give me a search query.")
    limit = max(1, min(int(args.get("limit", 20)), 200))
    config = agent.load_config()
    search = config.get("search")
    commands = []
    if isinstance(search, list) and search:
        commands.append(search + [query])
    home = os.path.expanduser("~")
    commands.extend([["/usr/bin/mdfind", "-onlyin", home, "-name", query],
                     ["/usr/bin/mdfind", "-onlyin", home, query]])
    found, seen = [], set()
    for argv in commands:
        try:
            proc = child(argv)
        except (OSError, subprocess.TimeoutExpired, ValueError):
            continue
        if proc.returncode:
            continue
        for line in proc.stdout.splitlines():
            candidate = line.split("  ", 1)[0].strip()
            if not candidate.startswith(("/", "~")):
                continue
            path = os.path.realpath(os.path.expanduser(candidate))
            if not os.path.exists(path) or path in seen or agent.denied(path, config.get("private_paths", [])):
                continue
            found.append(path)
            seen.add(path)
            if len(found) >= limit:
                return "\n".join(found)
    return "\n".join(found)


def list_folder(args):
    path = path_of(args.get("path", ""))
    if not os.path.isdir(path):
        fail("That's not a folder.")
    entries = []
    for entry in sorted(os.scandir(path), key=lambda item: item.name.lower()):
        if agent.denied(entry.path, agent.load_config().get("private_paths", [])):
            continue
        entries.append(entry.name + ("/" if entry.is_dir() else ""))
        if len(entries) == 200:
            break
    return "\n".join(entries)


def read_file(args):
    path = path_of(args.get("path", ""))
    if not os.path.isfile(path):
        fail("That's not a file.")
    limit = max(1, min(int(args.get("max_chars", 20000)), 100000))
    with open(path, "rb") as stream:
        head = stream.read(4096)
        if b"\0" in head:
            fail("That's not a text file.")
        size = stream.seek(0, os.SEEK_END)
        stream.seek(0)
        value = io.TextIOWrapper(stream, encoding="utf-8", errors="replace").read(limit + 1)
    if len(value) <= limit and size <= len(value.encode("utf-8")):
        return value
    return value[:limit] + "\n[… truncated, about %d more bytes]" % max(1, size - len(value[:limit].encode("utf-8")))


def reveal(args):
    path = path_of(args.get("path", ""))
    if not os.path.exists(path):
        fail("That path doesn't exist.")
    proc = child([os.environ.get("BUDDY_OPEN", "/usr/bin/open"), "-R", path])
    if proc.returncode:
        fail("Finder couldn't show that path.")
    return "Showing %s in Finder." % os.path.basename(path)


def open_target(args):
    target = str(args.get("target", ""))
    executable = os.environ.get("BUDDY_OPEN", "/usr/bin/open")
    if re.match(r"^https?://", target, re.I):
        argv = [executable, target]
    elif os.path.exists(os.path.expanduser(target)):
        path = path_of(target)
        suffix = Path(path).suffix.lower()
        if suffix in {".command", ".tool", ".sh", ".terminal", ".workflow", ".action", ".pkg", ".mpkg", ".jar"} or (suffix != ".app" and os.path.isfile(path) and os.access(path, os.X_OK)):
            fail("I don't open scripts or installers.")
        argv = [executable, path]
    elif re.match(r"^[A-Za-z][A-Za-z0-9+.-]*:", target):
        fail("I only open files, apps and web links.")
    else:
        if not target:
            fail("Give me an app, file or web link.")
        argv = [executable, "-a", target]
    proc = child(argv)
    if proc.returncode:
        if "-a" in argv:
            fail("Couldn't find an app called %s." % target)
        fail("I couldn't open that.")
    return "Opened %s." % target


def read_source(args):
    name = str(args.get("name", ""))
    sources = agent.load_config().get("sources") or {}
    if name not in sources:
        fail("Unknown source: %s." % name)
    if MODE == "job" and name not in os.environ.get("BUDDY_ALLOWED_SOURCES", "").split(","):
        fail("That source isn't allowed for this job.")
    source = sources[name]
    argv = source.get("cmd")
    arg = str(args.get("arg", ""))
    pattern = source.get("arg")
    if pattern and not re.fullmatch(pattern, arg):
        fail("That source argument is invalid.")
    if not isinstance(argv, list):
        fail("That source isn't configured with an argv list.")
    if any(isinstance(part, str) and "{arg}" in part for part in argv) and not pattern:
        fail("That source needs an argument rule.")
    argv = [part.replace("{arg}", arg) if isinstance(part, str) else part for part in argv]
    timeout = float(os.environ.get("BUDDY_SOURCE_TIMEOUT", "60"))
    try:
        proc, truncated = source_child(argv, timeout=timeout)
    except subprocess.TimeoutExpired:
        fail("%s didn't answer in 60 s." % name)
    if proc.returncode:
        fail("%s failed: %s" % (name, proc.stderr[-300:].strip()))
    return proc.stdout.rstrip("\n") + ("\n[… truncated]" if truncated else "")


def trigger_valid(value):
    message = 'Invalid trigger. Use sit_down, daily_at with HH:MM, or every with minutes and optional until.'
    if not isinstance(value, dict):
        fail(message)
    if value.get("type") == "sit_down":
        return
    if value.get("type") == "daily_at" and re.fullmatch(r"(?:[01][0-9]|2[0-3]):[0-5][0-9]", str(value.get("at", ""))):
        return
    if value.get("type") == "every":
        minutes = value.get("minutes")
        minimum = max(1, int(agent.load_config().get("watch_min", 15)))
        if isinstance(minutes, bool) or not isinstance(minutes, int) or minutes < minimum:
            fail(message)
        now = int(time.time())
        until = value.get("until")
        if until is None:
            today = datetime.fromtimestamp(now)
            until = int(today.replace(hour=23, minute=59, second=59, microsecond=0).timestamp())
            value["until"] = until
        if isinstance(until, bool) or not isinstance(until, int) or until <= now or until > now + 7 * 86400:
            fail(message)
        return
    fail(message)


def sources_valid(value):
    if not isinstance(value, list) or any(name not in (agent.load_config().get("sources") or {}) for name in value):
        fail("Unknown source in automation.")


def automations_list(args):
    runs = agent.load_runs()
    lines = []
    for job in agent.load_jobs():
        trigger = job.get("trigger") or {}
        words = ("when I sit down" if trigger.get("type") == "sit_down" else
                 "every %sm until %s" % (trigger.get("minutes", "?"), trigger.get("until", "?"))
                 if trigger.get("type") == "every" else "daily at %s" % trigger.get("at", "?"))
        run = runs.get(job.get("id"), {})
        when = run.get("finishedAt") or run.get("startedAt") or "never" if isinstance(run, dict) else "never"
        outcome = (" (succeeded)" if run.get("ok") else " (failed)") if isinstance(run, dict) and "ok" in run else ""
        lines.append("%s | %s | %s | sources: %s | enabled: %s | last run: %s%s" %
                     (job.get("id"), job.get("name"), words, ", ".join(job.get("sources", [])),
                      job.get("enabled"), when, outcome))
    return "\n".join(lines)


def automations_add(args):
    name = str(args.get("name", "")).strip()
    instructions = str(args.get("instructions", "")).strip()
    if not name or not instructions:
        fail("Name and instructions are required.")
    trigger = args.get("trigger")
    sources = args.get("sources")
    trigger_valid(trigger)
    sources_valid(sources)
    slug = re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-") or "job"
    job = {"id": slug + "-" + secrets.token_hex(2), "name": name, "trigger": trigger,
           "instructions": instructions, "sources": sources, "enabled": True,
           "createdAt": int(time.time()),
           "created_at": datetime.now().isoformat(timespec="seconds")}
    if trigger["type"] == "every" and os.environ.get("BUDDY_TOOLS_ORIGIN") == "telegram":
        job["origin"] = "telegram"
    with agent.edit_jobs() as jobs:
        jobs.append(job)
    return json.dumps(job, ensure_ascii=False)


def automations_change(args):
    if "trigger" in args:
        trigger_valid(args["trigger"])
    if "sources" in args:
        sources_valid(args["sources"])
    with agent.edit_jobs() as jobs:
        job = next((item for item in jobs if item.get("id") == args.get("id")), None)
        if job is None:
            fail("Unknown automation.")
        was_every = (job.get("trigger") or {}).get("type") == "every"
        for key in ("name", "trigger", "instructions", "sources", "enabled"):
            if key in args:
                job[key] = args[key]
        start = job.get("createdAt")
        if job["trigger"]["type"] == "every" and (not was_every or isinstance(start, bool) or
                not isinstance(start, (int, float)) or start <= 0):
            job["createdAt"] = int(time.time())  # a converted watch starts its interval now
    return json.dumps(job, ensure_ascii=False)


def automations_remove(args):
    with agent.edit_jobs() as jobs:
        job = next((item for item in jobs if item.get("id") == args.get("id")), None)
        if job is None:
            fail("Unknown automation.")
        jobs[:] = [item for item in jobs if item is not job]
    return "Removed %s." % job.get("name", "automation")


def remember(args):
    note = str(args.get("note", "")).strip()
    if not note:
        fail("Give me a note.")
    agent.AGENT.mkdir(parents=True, exist_ok=True)
    with (agent.AGENT / "notes-new.jsonl").open("a") as out:
        out.write(json.dumps({"note": note}, ensure_ascii=False) + "\n")
    return "Noted."


def chat_search(args):
    words = re.findall(r"\w+", str(args.get("query", "")).casefold())
    if not words:
        fail("Give me words to search for.")
    limit = max(1, min(int(args.get("limit", 10)), 50))
    archive = Path(os.environ.get("BUDDY_CHAT_ARCHIVE") or agent.AGENT.parent / "chat-archive.jsonl")
    try:
        lines = archive.read_text(encoding="utf-8").splitlines()
    except OSError:
        return "No archived chat yet."
    entries = []
    for line in lines:
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if isinstance(entry, dict) and isinstance(entry.get("content"), str):
            entries.append(entry)
    matches = []
    for i, entry in enumerate(entries):
        content = entry["content"].casefold()
        counts = [len(re.findall(r"(?<!\w)" + re.escape(word) + r"(?!\w)", content)) for word in words]
        if all(counts):
            matches.append((sum(counts), entry.get("at") or 0, i))
    matches.sort(key=lambda item: (-item[0], -item[1]))
    out = []
    for _, _, i in matches[:limit]:
        entry = entries[i]
        at = entry.get("at") or 0
        try:
            date = datetime.fromtimestamp(float(at)).strftime("%Y-%m-%d %H:%M")
        except (ValueError, TypeError, OverflowError, OSError):
            date = "unknown date"
        who = entry.get("name") or {"user": "Them", "assistant": "Buddy", "note": "Notes"}.get(entry.get("role"), entry.get("role") or "Unknown")
        channel = entry.get("via") or "desktop"
        before = entries[i - 1]["content"] if i else ""
        after = entries[i + 1]["content"] if i + 1 < len(entries) else ""
        out.append(f"{date} | {who} | {channel}\nBefore: {before}\nMatch: {entry['content']}\nAfter: {after}")
    return "\n\n".join(out) if out else "No matching chat lines."


def tasks_on():
    # Buddy writes tasks = true into config.json unless config.lua says tasks = false.
    return MODE == "chat" and agent.load_config().get("tasks") is True


def task_start(args):
    task = str(args.get("task", "")).strip()
    name = " ".join(str(args.get("name", "")).split())[:40]
    if not task or not name:
        fail("Give the session a task and a short name.")
    folder = path_of(args.get("folder") or "~")
    if not os.path.isdir(folder):
        fail("That's not a folder.")
    tasks.propose({"kind": "start", "task": task[:4000], "name": name, "folder": folder})
    return ("Buddy will ask them for a yes or no, then open the session and send them its phone link. Don't ask "
            "them to confirm yourself; say in a few words what you're about to start.")


def task_send(args):
    task = tasks.load(str(args.get("id", "")))
    text = str(args.get("text", "")).strip()
    if not task or task.get("state") == "ended":
        fail("No running session with that id. Check task_list.")
    if not text:
        fail("Give me the message to pass on.")
    tasks.propose({"kind": "send", "id": task["id"], "name": task.get("name"), "text": text[:4000]})
    return "Buddy will pass it on to %s (asking them first if those aren't their own words)." % task.get("name")


def task_list(args):
    lines = []
    for task in tasks.sweep():
        last = " ".join((task.get("last") or "").split())[:200]
        lines.append("%s | %s | %s | folder: %s | link: %s | last said: %s" %
                     (task["id"], task.get("name"), task.get("state"), task.get("folder"),
                      task.get("url") or "none yet", last or "nothing yet"))
    return "\n".join(lines) if lines else "No sessions yet."


def health_on():
    # Buddy passes the folder only to chat, and only when config.lua turned health on.
    return MODE != "job" and bool(os.environ.get("BUDDY_HEALTH_DIR"))


def health_folder():
    return Path(os.path.expanduser(os.environ["BUDDY_HEALTH_DIR"]))


def health_log(args):
    kind = str(args.get("kind", ""))
    text = str(args.get("text", "")).strip()
    if kind not in HEALTH_KINDS:
        fail("kind must be one of: %s." % ", ".join(HEALTH_KINDS))
    if not text:
        fail("Give me some text to record.")
    folder = health_folder()
    folder.mkdir(parents=True, exist_ok=True)
    line = json.dumps({"kind": kind, "text": text[:500], "at": int(time.time())}, ensure_ascii=False)
    with (folder / "health-new.jsonl").open("a") as out:
        out.write(line + "\n")
    return "Recorded."


def health_entries(value):
    return [{key: item[key] for key in ("kind", "text", "at") if key in item}
            for item in value if isinstance(item, dict) and isinstance(item.get("text"), str)
            and isinstance(item.get("at"), (int, float))] if isinstance(value, list) else []


def health_get(args):
    folder = health_folder()
    try:
        saved = json.loads((folder / "health.json").read_text())
    except (OSError, ValueError):
        saved = {}
    saved = saved if isinstance(saved, dict) else {}
    goals, plans = health_entries(saved.get("goals")), health_entries(saved.get("plans"))
    log = health_entries(saved.get("log"))
    pending = []  # what the tools wrote since Buddy last folded it in
    try:
        lines = (folder / "health-new.jsonl").read_text().splitlines()
    except OSError:
        lines = []
    for line in lines:
        try:
            pending.append(json.loads(line))
        except ValueError:
            pass
    for item in health_entries(pending):
        if item.get("kind") in HEALTH_KINDS:
            {"goal": goals, "plan": plans}.get(item["kind"], log).append(item)
    cutoff = time.time() - HEALTH_DAYS * 86400
    log = sorted((item for item in log if item["at"] >= cutoff), key=lambda item: item["at"])
    return json.dumps({"goals": goals, "plans": plans[-5:], "log": log}, ensure_ascii=False)


def ai_list(args):
    return ai.describe(ai.status())


CALLS = {"ai_list": ai_list, "find_files": find_files, "list_folder": list_folder, "read_file": read_file,
         "reveal": reveal, "open": open_target, "read_source": read_source,
         "automations_list": automations_list, "automations_add": automations_add,
         "automations_change": automations_change, "automations_remove": automations_remove,
         "remember": remember, "chat_search": chat_search, "health_log": health_log, "health_get": health_get,
         "task_start": task_start, "task_send": task_send, "task_list": task_list}


def tool_specs():
    configured = agent.load_config().get("sources") or {}
    allowed = set(os.environ.get("BUDDY_ALLOWED_SOURCES", "").split(",")) if MODE == "job" else None
    catalog = []
    for name, source in sorted(configured.items()):
        if (allowed is None or name in allowed) and isinstance(source, dict):
            catalog.append("%s — %s (argument: %s)" %
                           (name, source.get("about", "No description"), source.get("arg", "none")))
    details = "\n".join(catalog) if catalog else "No sources configured."
    descriptions = {
        "read_source": "Read a configured local source. Source names must be names from this list:\n" + details,
        "automations_add": "Add a Buddy automation. Sources must be names from this list:\n" + details,
        "automations_change": "Change a Buddy automation. Sources must be names from this list:\n" + details,
    }
    out = [dict(tool, description=descriptions.get(tool["name"], tool["description"]))
           for tool in TOOLS if (MODE != "job" or tool["name"] in JOB_TOOLS)
           and (tool["name"] not in HEALTH_TOOLS or health_on())
           and (tool["name"] not in TASK_TOOLS or tasks_on())]
    for tool in out:
        if tool["name"] == "task_start":  # the folder it can pick from: their projects
            known = tasks.folders(agent.load_config())
            folder = "The folder it works in, an absolute path. Leave it out for the home folder." + (
                " Their project folders:\n" + "\n".join(known) if known else "")
            props = dict(tool["inputSchema"]["properties"], folder={"type": "string", "description": folder})
            tool["inputSchema"] = dict(tool["inputSchema"], properties=props)
    return out


def handle(msg):
    method, params = msg.get("method"), msg.get("params") or {}
    if method == "initialize":
        return {"protocolVersion": params.get("protocolVersion", "2025-06-18"),
                "capabilities": {"tools": {}}, "serverInfo": {"name": "buddy", "version": "1"}}
    if method == "tools/list":
        return {"tools": tool_specs()}
    if method == "tools/call":
        name = params.get("name")
        ok = False
        try:
            if name not in CALLS or (MODE == "job" and name not in JOB_TOOLS) or \
                    (name in HEALTH_TOOLS and not health_on()) or \
                    (name in TASK_TOOLS and not tasks_on()):
                fail("That tool isn't available.")
            value = CALLS[name](params.get("arguments") or {})
            ok = True
            return result(value)
        except subprocess.TimeoutExpired:
            return result("That tool took too long.", True)
        except (ValueError, OSError, TypeError, KeyError, re.error, subprocess.SubprocessError) as exc:
            return result(str(exc), True)
        finally:
            agent.log({"tool": name, "ok": ok, "mode": MODE})
    if method == "ping":
        return {}
    raise LookupError(method)


def main():
    for line in sys.stdin:
        try:
            msg = json.loads(line)
        except ValueError:
            continue
        if "id" not in msg:
            continue
        try:
            reply = {"jsonrpc": "2.0", "id": msg["id"], "result": handle(msg)}
        except LookupError as exc:
            reply = {"jsonrpc": "2.0", "id": msg["id"], "error": {"code": -32601, "message": "unknown method %s" % exc}}
        sys.stdout.write(json.dumps(reply) + "\n")
        sys.stdout.flush()


if __name__ == "__main__":
    main()
