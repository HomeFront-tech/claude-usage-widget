#!/usr/bin/env python3
"""Stand-in for `security find-generic-password -s SERVICE [-a ACCOUNT] -w` in tests.
FAKE_KEYCHAIN: JSON list of {"acct", "svce", "secret"} in keychain order. Like the real
one, a lookup without -a gets the first item for the service. Not found exits 44."""
import json
import os
import sys

args = sys.argv[1:]
want = {args[i]: args[i + 1] for i in range(len(args) - 1) if args[i] in ("-s", "-a")}
for item in json.loads(os.environ.get("FAKE_KEYCHAIN") or "[]"):
    if item["svce"] == want.get("-s") and want.get("-a", item["acct"]) == item["acct"]:
        print(item["secret"])
        sys.exit(0)
print("security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain.",
      file=sys.stderr)
sys.exit(44)
