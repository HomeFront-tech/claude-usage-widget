#!/usr/bin/env python3
"""Stand-in for `claude -p` in tests. FAKE_CLAUDE_ARGV: file to write argv to (JSON).
FAKE_CLAUDE_RESULT: the answer to print. FAKE_CLAUDE_RC: exit code (default 0)."""
import json
import os
import sys

if os.environ.get("FAKE_CLAUDE_ARGV"):
    with open(os.environ["FAKE_CLAUDE_ARGV"], "w") as f:
        json.dump(sys.argv[1:], f)
rc = int(os.environ.get("FAKE_CLAUDE_RC", "0"))
print(json.dumps({"type": "result", "subtype": "success" if rc == 0 else "error", "is_error": rc != 0,
                  "result": os.environ.get("FAKE_CLAUDE_RESULT", "")}))
sys.exit(rc)
