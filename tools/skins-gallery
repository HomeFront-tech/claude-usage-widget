#!/bin/sh
# Open the skins gallery in Chrome: every skins/*.json drawn the way Buddy draws it,
# with buttons to play each skin's reactions. New or changed skins show up by themselves.
#   tools/skins-gallery
# It serves only the skins folder and the gallery page (from a scratch folder of links),
# on 127.0.0.1:8742, until you log out or stop it: tools/skins-gallery stop
set -eu
cd "$(dirname "$0")/.."
port=8742
dir="${TMPDIR:-/tmp}/buddy-skins-gallery"
url="http://127.0.0.1:$port/tools/skins.html"
if [ "${1:-}" = stop ]; then
  pid=$(cat "$dir/pid" 2>/dev/null || true)
  # only stop it if that pid is still our http.server (after a reboot it could be anything)
  if [ -n "$pid" ] && ps -p "$pid" -o command= 2>/dev/null | grep -q "http.server $port"; then
    kill "$pid" && echo "stopped"
  fi
  rm -f "$dir/pid"
  exit 0
fi
mkdir -p "$dir/tools"
ln -sfn "$PWD/skins" "$dir/skins"
ln -sf "$PWD/tools/skins.html" "$dir/tools/skins.html"
if ! curl -s -o /dev/null "$url"; then
  nohup python3 -m http.server "$port" --bind 127.0.0.1 --directory "$dir" >/dev/null 2>&1 &
  echo $! > "$dir/pid"
  sleep 0.5
fi
if [ -d "/Applications/Google Chrome.app" ]; then open -a "Google Chrome" "$url"; else open "$url"; fi
echo "$url"
