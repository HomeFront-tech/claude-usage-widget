#!/bin/sh
# Publish an update to everyone who installed the widget.
#   tools/release 1.2.0 "What changed, one line per item"
# Bumps VERSION, commits it, tags v1.2.0, pushes, and creates the GitHub release that
# installed copies check every 6 hours. Commit your changes first. Needs the gh CLI.
# It also checks whatsnew/releases.json and stamps its "next" entry with this version.
# Pushing without a release doesn't notify anyone, so main can hold work in progress.
set -eu
cd "$(dirname "$0")/.."

version=${1:-}
notes=${2:-}
case "$version" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) echo "usage: tools/release <version like 1.2.0> [\"notes\"]" >&2; exit 1 ;;
esac
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
  echo "You have uncommitted changes. Commit them first." >&2
  exit 1
fi
if git rev-parse -q --verify "refs/tags/v$version" >/dev/null; then
  echo "v$version already exists. Pick a higher version (current: $(cat VERSION))." >&2
  exit 1
fi

# The What's New window's content: check it, then name its "next" draft after this
# version, in the release commit itself. A fix-only release without a draft is fine.
whatsnew=whatsnew/releases.json
if [ -f "$whatsnew" ]; then
  tools/whatsnew check || { echo "Fix $whatsnew first." >&2; exit 1; }
  tools/whatsnew stamp "$version" || exit 1
fi

echo "$version" > VERSION
git add VERSION
if [ -f "$whatsnew" ]; then git add "$whatsnew"; fi
git commit -q -m "Release v$version"
git tag -a "v$version" -m "v$version"
git push -q origin HEAD "v$version"
if [ -n "$notes" ]; then
  gh release create "v$version" --title "v$version" --notes "$notes"
else
  gh release create "v$version" --title "v$version" --generate-notes
fi
if [ -f "$whatsnew" ] && ! grep -Eq "\"version\": *\"$version\"" "$whatsnew"; then
  echo "Note: no What's New entry for v$version; people get the plain bubble."
fi
echo "Released v$version. Installed copies will see it within 6 hours."
