#!/bin/sh
# Live check of the buddy's voice on this Mac: is the mic deaf to his own speech?
# Starts ear/buddy-ear through Hammerspoon (so it uses Hammerspoon's microphone
# permission), measures its CPU in a quiet room, then has it say a sentence through the
# speakers with echo cancellation on. PASS when none of his words were heard.
set -e
R=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
HS=$(command -v hs || echo /opt/homebrew/bin/hs)
[ -x "$HS" ] || { echo "voice-check needs Hammerspoon's hs command (run hs.ipc.cliInstall() in its console)"; exit 1; }
"$R/ear/build.sh"
T=$(mktemp -d)
F="$T/in"; LOG="$T/out"
mkfifo "$F"
"$HS" -c "VoiceCheck = hs.task.new('/bin/sh', nil, {'-c', 'exec \"$R/ear/buddy-ear\" <\"$F\" >\"$LOG\" 2>&1'}); VoiceCheck:start(); return 'ok'" </dev/null >/dev/null
exec 3>"$F" # the helper quits when this closes
wait_for() { # pattern, tenths of a second
  i=0
  until grep -q "$1" "$LOG" 2>/dev/null; do
    sleep 0.1; i=$((i + 1))
    if [ $i -ge "$2" ]; then echo "FAIL: no $1 from buddy-ear"; cat "$LOG"; exit 1; fi
  done
}
wait_for '"ready"' 100
sleep 15
pid=$(pgrep -f "$R/ear/buddy-ear" | head -1)
cpu=0
for _ in 1 2 3 4 5; do cpu=$(echo "$cpu + $(ps -o %cpu= -p "$pid")" | bc); sleep 1; done
/usr/bin/say -o "$T/line.aiff" "Okay Buddy, this is a test of my own voice. If you can read these words, the echo cancellation did not work."
echo '{"cmd":"speak","id":1,"file":"'"$T/line.aiff"'"}' >&3
wait_for '"spoken"' 200
sleep 2.5 # let anything heard during the speech finish as an utterance
# Fail only on the buddy's own words: someone else talking in the room is fine
heard=$(sed -n '/"speaking"/,$p' "$LOG" | grep -E '"end"' | grep -iE 'echo|cancel|own voice|these words' || true)
exec 3>&-
echo "buddy-ear CPU in a quiet room: $(echo "scale=1; $cpu / 5" | bc)% of one core"
if [ -n "$heard" ]; then echo "FAIL: it heard itself:"; echo "$heard"; exit 1; fi
echo "PASS: it didn't hear itself"
rm -rf "$T"
