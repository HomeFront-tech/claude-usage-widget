#!/usr/bin/env python3
"""Builds Claude Buddy.app: the card and Buddy in their own copy of the Hammerspoon engine.

usage: tools/build-app [--dest DIR] [--engine APP | --download] [--migrate] [--handoff]
                       [--launch] [--remove]

It copies Hammerspoon.app (yours in /Applications or ~/Applications, or with --download,
or when you have none, the latest release from Hammerspoon's GitHub), checks that
Hammerspoon's team signed it, and turns the copy into Claude Buddy: its own name, bundle
ID, icon, menu labels and permissions; Sparkle updates off (they'd put Hammerspoon back
over it); crash reports to Hammerspoon's team off; Hammerspoon's MIT licence kept inside.
The app runs app/init.lua from this folder, so `git pull` and Buddy's updater keep
updating it. It's signed on this Mac (ad hoc, or BUDDY_SIGN_IDENTITY), so macOS asks for
Screen Recording and the microphone again after each rebuild.

  --dest DIR   where the app goes (default /Applications)
  --migrate    the app copies Buddy's settings (chat, notes, the card's spot...) from the
               regular Hammerspoon when it first starts, unless it has its own already
  --handoff    for "Make Buddy an app": the regular Hammerspoon opens the app once,
               right after its reload
  --launch     hand Buddy over now: reload a running Hammerspoon (it steps aside and
               opens the app), or open the app
  --remove     quit and delete the app and its note (its settings stay); the regular
               Hammerspoon has Buddy back after its next reload
"""
import argparse
import datetime
import json
import os
import plistlib
import shutil
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
NAME = "Claude Buddy"
BUNDLE_ID = "com.github.claude-usage-widget.claude-buddy"  # app.lua's A.BUNDLE_ID
ENGINE_ID = "org.hammerspoon.Hammerspoon"
ENGINE_TEAM = "VQCYSNZB89"  # Hammerspoon's Developer ID team
# Signed by an Apple-issued certificate of that team. codesign checks this itself, where the
# text of `codesign -dv` also carries the file's path, which anyone can name.
ENGINE_REQ = ('anchor apple generic and identifier "%s" and certificate leaf[subject.OU] = "%s"'
              % (ENGINE_ID, ENGINE_TEAM))
RELEASES = "https://api.github.com/repos/Hammerspoon/hammerspoon/releases/latest"
SUPPORT = Path.home() / "Library/Application Support/claude-usage-widget"
MARKER = SUPPORT / "app.json"  # app.lua's A.MARKER
LSREGISTER = ("/System/Library/Frameworks/CoreServices.framework/Frameworks/"
              "LaunchServices.framework/Support/lsregister")


